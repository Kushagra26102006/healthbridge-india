# ==============================================================================
# HealthBridge India — Root Environment Variable Template (.env.example)
# Note: Copy this file to apps/api/.env and apps/web/.env.local respectively
# ==============================================================================

# Backend (apps/api) Environment Variables
NODE_ENV=development
PORT=5001
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/healthbridge_dev?retryWrites=true&w=majority
CORS_ORIGIN=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# Authentication & Security Keys (Replace with 32+ char cryptographic keys)
JWT_ACCESS_SECRET=your_jwt_access_secret_key_minimum_32_chars
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_minimum_32_chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_SECRET=your_secure_cookie_signing_secret_min_16_chars

# Ayushman Bharat Digital Mission (ABDM) Integration (Backend Only — Placeholders Only)
# Keep ABDM_ENABLED=false and ABDM_ALLOW_PRODUCTION=false until sandbox onboarding & approvals complete
ABDM_ENABLED=false
ABDM_ENVIRONMENT=disabled
ABDM_BASE_URL=https://dev.abdm.gov.in
ABDM_ABHA_BASE_URL=https://abhasbx.abdm.gov.in/abha/api/v3
ABDM_X_CM_ID=sbx
ABDM_CLIENT_ID=your_abdm_sandbox_client_id
ABDM_CLIENT_SECRET=your_abdm_sandbox_client_secret
ABDM_CALLBACK_URL=https://your-api-domain.example/api/v1/abdm/webhooks/callback
ABDM_WEBHOOK_SECRET=your_abdm_webhook_verification_secret_placeholder
ABDM_IDENTIFIER_ENCRYPTION_KEY=your_32_byte_hex_or_strong_key_for_abha_storage_encryption
ABDM_REQUEST_TIMEOUT_MS=15000
ABDM_ALLOW_PRODUCTION=false

# Frontend (apps/web) Environment Variables
NEXT_PUBLIC_APP_NAME="HealthBridge India"
NEXT_PUBLIC_API_URL=http://localhost:5001/api/v1

