# ==============================================================================
# HealthBridge India — Root Environment Variable Template (.env.example)
# Copy placeholders into apps/api/.env and apps/web/.env.local (NEVER commit real secrets)
# ==============================================================================

# --- Backend Runtime (apps/api) ---
NODE_ENV=development
PORT=5001
TRUST_PROXY_HOPS=0
ENABLE_BACKGROUND_WORKER=true

# --- Database (MongoDB Atlas TLS required in production; localhost forbidden in prod) ---
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/healthbridge_dev?retryWrites=true&w=majority
DB_MAX_POOL_SIZE=20
DB_MIN_POOL_SIZE=5

# --- CORS & Domain Origins (HTTPS explicit origins required in production; comma-separated supported) ---
CORS_ORIGIN=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# --- Authentication & Cryptographic Secrets (32+ char unique random secrets required in production) ---
JWT_ACCESS_SECRET=your_jwt_access_secret_key_minimum_32_chars
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_minimum_32_chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_SECRET=your_secure_cookie_signing_secret_min_32_chars
ADMIN_REGISTRATION_KEY=your_admin_registration_secret_key_min_32_chars

# --- Ayushman Bharat Digital Mission (ABDM) Integration (Backend Only — Placeholders Only) ---
# Keep ABDM_ENABLED=false and ABDM_ALLOW_PRODUCTION=false until NHA onboarding & approvals complete
ABDM_ENABLED=false
ABDM_ENVIRONMENT=disabled
ABDM_BASE_URL=https://dev.abdm.gov.in
ABDM_ABHA_BASE_URL=https://abhasbx.abdm.gov.in/abha/api/v3
ABDM_X_CM_ID=sbx
ABDM_CLIENT_ID=your_abdm_sandbox_client_id
ABDM_CLIENT_SECRET=your_abdm_sandbox_client_secret
ABDM_CALLBACK_URL=https://api.your-domain.example/api/v1/abdm/webhooks/callback
ABDM_WEBHOOK_SECRET=your_abdm_webhook_verification_secret_placeholder
ABDM_IDENTIFIER_ENCRYPTION_KEY=your_32_byte_hex_or_strong_key_for_abha_storage_encryption
ABDM_REQUEST_TIMEOUT_MS=15000
ABDM_ALLOW_PRODUCTION=false

# --- Telemedicine / Video Consultation (Backend Only — Never Expose Secrets to Frontend) ---
# Supported providers: webrtc_direct (local dev signaling) | livekit (managed or self-hosted SFU)
VIDEO_PROVIDER=webrtc_direct
VIDEO_LIVEKIT_URL=wss://your-livekit-instance.livekit.cloud
VIDEO_LIVEKIT_API_KEY=your_livekit_api_key_placeholder
VIDEO_LIVEKIT_API_SECRET=your_livekit_api_secret_placeholder
VIDEO_TOKEN_TTL_SECONDS=900
# Recording MUST remain disabled by default unless explicit consent & retention policy are implemented
VIDEO_RECORDING_ENABLED=false
VIDEO_ICE_SERVERS_JSON=[{"urls":["stun:stun.l.google.com:19302"]}]

# --- Frontend Public Variables (apps/web — NEVER place secrets in NEXT_PUBLIC_*) ---
NEXT_PUBLIC_APP_NAME="HealthBridge India"
NEXT_PUBLIC_API_URL=http://localhost:5001/api/v1
# Optional WebSocket origin when LiveKit SFU is enabled (public endpoint only, never credentials)
# NEXT_PUBLIC_VIDEO_WS_ORIGIN=wss://your-livekit-instance.livekit.cloud
