{
  "name": "healthbridge-india-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "HealthBridge India — One Nation One Health Record — ABHA Integrated Healthcare Platform",
  "packageManager": "pnpm@9.15.5",
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "dev:web": "pnpm --filter @healthbridge/web dev",
    "dev:api": "pnpm --filter @healthbridge/api dev",
    "build": "pnpm --recursive run build",
    "lint": "pnpm --recursive run lint",
    "type-check": "pnpm --recursive run type-check",
    "typecheck": "pnpm --recursive run type-check",
    "test": "pnpm --filter @healthbridge/api test",
    "test:unit": "pnpm --filter @healthbridge/api test:unit",
    "test:web": "pnpm --filter @healthbridge/web test",
    "test:integration": "pnpm --filter @healthbridge/api test:integration",
    "test:api-e2e": "pnpm --filter @healthbridge/api test:e2e",
    "test:all": "pnpm test:web && pnpm test:unit && pnpm test:integration && pnpm test:api-e2e",
    "verify:integration": "pnpm --filter @healthbridge/api exec tsx ../../scripts/verify-integration.ts",
    "test:e2e": "pnpm --filter @healthbridge/api exec tsx ../../scripts/e2e-foundation-test.ts",
    "seed": "pnpm --filter @healthbridge/api seed",
    "db:sync-indexes": "pnpm --filter @healthbridge/api db:sync-indexes",
    "smoke:prod": "node scripts/production-smoke-test.mjs",
    "test:db": "pnpm --filter @healthbridge/api test:db",
    "test:auth": "pnpm --filter @healthbridge/api test:auth",
    "audit:frontend": "pnpm --filter @healthbridge/api exec tsx ../../scripts/verify-frontend-auth.ts",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "clean": "rm -rf node_modules apps/*/.next apps/*/dist packages/*/dist"
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "typescript": "^5.6.3"
  },
  "pnpm": {
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-h25m-26qc-wcjf",
        "GHSA-q4gf-8mx6-v5v3",
        "GHSA-8h8q-6873-q5fj",
        "GHSA-c4j6-fc7j-m34r",
        "GHSA-36qx-fr4f-26g5",
        "GHSA-m99w-x7hq-7vfj",
        "GHSA-89xv-2m56-2m9x",
        "GHSA-p9j2-gv94-2wf4",
        "GHSA-6g55-p6wh-862q",
        "GHSA-r28c-9q8g-f849",
        "GHSA-p293-qw3h-jr36",
        "GHSA-2xp9-vwfh-vxw4",
        "GHSA-2464-fhr4-w9xw",
        "GHSA-p3m5-59mp-jv5r",
        "GHSA-mrhx-c7xc-m3w5"
      ]
    }
  }
}
