# HealthBridge India API Environment Configuration

# Application
NODE_ENV=development
PORT=5001
TRUST_PROXY_HOPS=0
ENABLE_BACKGROUND_WORKER=true

# MongoDB Atlas Connection URI
# Example Atlas format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/healthbridge_dev?retryWrites=true&w=majority
# Example Local format: mongodb://127.0.0.1:27017/healthbridge_dev
MONGODB_URI=mongodb://127.0.0.1:27017/healthbridge_dev
DB_MAX_POOL_SIZE=20
DB_MIN_POOL_SIZE=5

# CORS Settings (Frontend URL; comma-separated HTTPS origins required in production)
CORS_ORIGIN=https://healthbridgeindia-kushagra.vercel.app,http://localhost:3000
FRONTEND_URL=https://healthbridgeindia-kushagra.vercel.app

# JWT Secrets (Unique >=32 characters required in production)
JWT_ACCESS_SECRET=your_jwt_access_secret_key_minimum_32_chars
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_minimum_32_chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Cookie & Admin Provisioning Secrets (Unique >=32 characters required in production)
COOKIE_SECRET=your_secure_cookie_signing_secret_min_32_chars
ADMIN_REGISTRATION_KEY=your_admin_registration_secret_key_min_32_chars

# Ayushman Bharat Digital Mission (ABDM) Integration Foundation (Backend Only — Placeholders Only)
ABDM_ENABLED=false
ABDM_ENVIRONMENT=disabled
ABDM_BASE_URL=https://dev.abdm.gov.in
ABDM_ABHA_BASE_URL=https://abhasbx.abdm.gov.in/abha/api/v3
ABDM_X_CM_ID=sbx
ABDM_CLIENT_ID=your_abdm_sandbox_client_id
ABDM_CLIENT_SECRET=your_abdm_sandbox_client_secret
ABDM_CALLBACK_URL=https://your-api-domain.example/api/v1/abdm/webhooks/callback
ABDM_WEBHOOK_SECRET=your_abdm_webhook_verification_secret_placeholder
ABDM_IDENTIFIER_ENCRYPTION_KEY=your_32_byte_hex_or_strong_key_for_abha_storage_encryption
ABDM_REQUEST_TIMEOUT_MS=15000
ABDM_ALLOW_PRODUCTION=false

# --- Telemedicine / Video Consultation ---
VIDEO_PROVIDER=webrtc_direct
VIDEO_LIVEKIT_URL=wss://your-livekit-instance.livekit.cloud
VIDEO_LIVEKIT_API_KEY=your_livekit_api_key_placeholder
VIDEO_LIVEKIT_API_SECRET=your_livekit_api_secret_placeholder
VIDEO_TOKEN_TTL_SECONDS=900
VIDEO_RECORDING_ENABLED=false
VIDEO_ICE_SERVERS_JSON=[{"urls":["stun:stun.l.google.com:19302"]}]

# --- Synthetic Demo Accounts Configuration ---
DEMO_ACCOUNTS_ENABLED=true
DEMO_PATIENT_PASSWORD=
DEMO_DOCTOR_PASSWORD=
DEMO_PHARMACY_PASSWORD=
DEMO_LAB_PASSWORD=
DEMO_ADMIN_PASSWORD=
ALLOW_PRODUCTION_DEMO_SEED=false
AUTH_RATE_LIMIT_MAX=120
LOGIN_RATE_LIMIT_MAX=30

