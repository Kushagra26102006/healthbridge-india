# HealthBridge India API Environment Configuration

# Application
NODE_ENV=development
PORT=5001

# MongoDB Atlas Connection URI
# Example Atlas format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/healthbridge_dev?retryWrites=true&w=majority
# Example Local format: mongodb://127.0.0.1:27017/healthbridge_dev
MONGODB_URI=mongodb://127.0.0.1:27017/healthbridge_dev

# CORS Settings (Frontend URL)
CORS_ORIGIN=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# JWT Secrets (Minimum 32 characters in production)
JWT_ACCESS_SECRET=hb_dev_access_token_secret_key_change_in_production_32chars
JWT_REFRESH_SECRET=hb_dev_refresh_token_secret_key_change_in_production_32chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Cookie Secret
COOKIE_SECRET=hb_dev_cookie_signing_secret_key_min_16chars

# Ayushman Bharat Digital Mission (ABDM) Integration Foundation (Backend Only — Placeholders Only)
ABDM_ENABLED=false
ABDM_ENVIRONMENT=disabled
ABDM_BASE_URL=https://dev.abdm.gov.in
ABDM_ABHA_BASE_URL=https://abhasbx.abdm.gov.in/abha/api/v3
ABDM_X_CM_ID=sbx
ABDM_CLIENT_ID=your_abdm_sandbox_client_id
ABDM_CLIENT_SECRET=your_abdm_sandbox_client_secret
ABDM_CALLBACK_URL=https://your-api-domain.example/api/v1/abdm/webhooks/callback
ABDM_WEBHOOK_SECRET=your_abdm_webhook_verification_secret_placeholder
ABDM_IDENTIFIER_ENCRYPTION_KEY=your_32_byte_hex_or_strong_key_for_abha_storage_encryption
ABDM_REQUEST_TIMEOUT_MS=15000
ABDM_ALLOW_PRODUCTION=false

