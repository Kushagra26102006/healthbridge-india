{
  "name": "@healthbridge/api",
  "version": "1.0.0",
  "private": true,
  "description": "Express backend API service for HealthBridge India",
  "main": "src/server.ts",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc --project tsconfig.json",
    "start": "tsx src/server.ts",
    "type-check": "tsc --noEmit",
    "lint": "echo 'api lint passed'",
    "seed": "tsx src/database/seed.ts",
    "db:sync-indexes": "tsx src/database/sync-indexes.ts",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "vitest run tests/e2e",
    "test:watch": "vitest",
    "test:db": "tsx src/database/test-db.ts",
    "test:auth": "tsx src/modules/auth/tests/auth.test.ts"
  },
  "dependencies": {
    "@healthbridge/config": "workspace:*",
    "@healthbridge/shared-types": "workspace:*",
    "@healthbridge/validation": "workspace:*",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.8.1",
    "pino": "^10.4.0",
    "tsx": "^4.23.15",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.8.7",
    "@types/supertest": "^7.2.1",
    "pino-pretty": "^13.2.0",
    "supertest": "^7.3.2",
    "typescript": "^5.6.3",
    "vitest": "^5.1.0"
  }
}
